    def getObjNameList(self) -> List[str]: ...
    def append(self, obj: DataCategoryBase) -> None: ...
    def replace(self, obj: DataCategoryBase) -> None: ...
    def printIt(self, fh: TextIO=..., pType: str = 'brief') -> None: ...
