class ContainerBase:
    def __init__(self, name: str) -> None: ...
    # def __eq__(self, other): ...
    # def __hash__(self): ...
    def getObjCatalog(self) -> Dict[str, DataCategoryBase]: ...
    def getPropCatalog(self) -> Dict[str, Any]: ...
