    def getProp(self, propName: str) -> Optional[Any]: ...
    def getType(self) -> Optional[str]: ...
    def setType(self, cType: str) -> None: ...
    def getName(self) -> str: ...
    def setName(self, name: str) -> None: ...
    def exists(self, name: str) -> bool: ...
